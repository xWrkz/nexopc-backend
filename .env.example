# Never commit the real .env file.
WORDPRESS_DB_NAME=nexopc
WORDPRESS_DB_USER=nexopc_user
WORDPRESS_DB_PASSWORD=replace-with-a-long-random-password
MARIADB_ROOT_PASSWORD=replace-with-another-long-random-password
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_HTTP_PORT=8080
# Shared with the NexoPC frontend (same value). At least 32 chars. Empty = signup and checkout disabled.
NEXOPC_SIGNUP_SECRET=
# Public storefront URL, used for Mercado Pago return URLs.
NEXOPC_STORE_URL=https://nexopc.wrkz.net
# Mercado Pago (Checkout Pro via Orders API). Use TEST credentials outside production.
# Empty token = Mercado Pago option disabled. Webhook secret comes from Your integrations > Webhooks.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
